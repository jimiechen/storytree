{"name": "storytree-vscode", "displayName": "StoryTree IDE", "description": "AI-powered novel writing environment integrated into VS Code. Write, organize, and enhance your stories with AI assistance.", "version": "1.0.0", "publisher": "storytree", "license": "MIT", "main": "./dist/extension.js", "engines": { "vscode": "^1.85.0" }, "categories": ["Programming Languages", "Other", "Visualization"], "keywords": ["novel", "writing", "AI", "storytelling", "fiction", "IDE"], "activationEvents": ["onCommand:storytree.openDashboard", "onCommand:storytree.newProject", "onView:storytreeExplorer"], "main": "./dist/extension.js", "contributes": {"commands": [{"command": "storytree.openDashboard", "title": "Open StoryTree Dashboard", "category": "StoryTree"}, {"command": "storytree.newProject", "title": "Create New Project", "category": "StoryTree"}, {"command": "storytree.newChapter", "title": "Create New Chapter", "category": "StoryTree"}, {"command": "storytree.toggleAIChat", "title": "Toggle AI Chat Panel", "category": "StoryTree"}, {"command": "storytree.showSettings", "title": "Open StoryTree Settings", "category": "StoryTree"}, {"command": "storytree.wordCount", "title": "Show Word Count Statistics", "category": "StoryTree"}], "keybindings": [{"command": "storytree.openDashboard", "key": "cmd+shift+t", "mac": "cmd+shift+t"}, {"command": "storytree.newProject", "key": "cmd+shift+n", "mac": "cmd+shift+n"}, {"command": "storytree.newChapter", "key": "cmd+shift+c", "mac": "cmd+shift+c"}, {"command": "storytree.toggleAIChat", "key": "cmd+shift+i", "mac": "cmd+shift+i"}, {"command": "storytree.showSettings", "key": "cmd+shift+,", "mac": "cmd+shift+,"}], "menus": {"editor/title": [{"when": "resourceLangId == markdown", "command": "storytree.openDashboard", "group": "navigation"}], "view/item/context": [{"when": "view == storytreeExplorer && viewItem == project", "command": "storytree.openDashboard", "group": "inline"}, {"when": "view == storytreeExplorer && viewItem == project", "command": "storytree.newChapter", "group": "1_edit"}, {"when": "view == storytreeExplorer && viewItem == chapter", "command": "storytree.openDashboard", "group": "inline"}]}, "viewsContainers": {"activitybar": [{"id": "storytree-sidebar-container", "icon": "$(book)", "title": "StoryTree"}]}, "views": {"storytree-sidebar-container": [{"type": "treeview", "id": "storytreeExplorer", "name": "Projects", "icon": "$(folder-opened)", "when": "true", "contextValueTitles": {"project": "Project", "chapter": "Chapter", "scene": "Scene"}}]}, "configuration": {"title": "StoryTree IDE", "properties": {"storytree.ai.provider": {"type": "string", "enum": ["openai", "anthropic", "ollama", ""], "default": "", "description": "Default AI provider for writing assistance"}, "storytree.ai.openai.apiKey": {"type": "string", "default": "", "description": "OpenAI API key (stored in VS Code SecretStorage)"}, "storytree.ai.anthropic.apiKey": {"type": "string", "default": "", "description": "Anthropic API key (stored in VS Code SecretStorage)"}, "storytree.ai.ollama.baseUrl": {"type": "string", "default": "http://localhost:11434", "description": "Ollama local LLM service URL"}, "storytree.editor.autoSaveMs": {"type": "number", "default": 500, "description": "Auto-save interval in milliseconds (0 = off)"}}, "scripts": {"build:dev": "node esbuild.config.mjs", "build:prod": "node esbuild.config.mjs --prod", "watch": "node esbuild.config.mjs --watch", "test": "vitest run", "test:coverage": "vitest run --coverage", "package": "npx vsce package --no-dependencies --out storytree.vsix", "lint": "echo 'Linting not configured'", "vscode:prepublish": "npm run build:prod"}, "devDependencies": {"@types/node": "^25.5.2", "@types/vscode": "^1.85.0", "esbuild": "^0.24.0", "typescript": "^6.0.2", "vitest": "^4.1.2"}}