# PyArmor Configuration for StoryTree Python Scripts
#
# Usage:
#   pyarmor gen --config pyarmor.config -O dist/protected
#   pyarmor licenses --expired "2026-12-31" -O dist/licenses/
#

[pyarmor]
name = storytree-python
version = 1.0.0
platform = all

[restrict]
# Restrict to specific machine (bind to hardware)
bind_device = false

# Expiration date (empty = never expires)
expired = 

# Allow running in specific directories only
restrict_path = .storytree/python

# Limit concurrent instances
instances = 1

# Disable debug mode (prevent attaching debugger)
no_debug = true

# Anti-reverse engineering settings
[anti_reverse]
# Enable call stack verification
call_stack_check = true

# Enable thread check to prevent multi-thread debugging
thread_check = true

# Obfuscate bytecode
obfuscate_bytecode = true

# Encrypt string constants
encrypt_strings = true

# Protect imported modules
protect_modules = true

# Files to protect
[files]
# Python agent scripts that handle AI operations
paths = [
    "agents/",
    "scripts/*.py",
]

# Files to exclude from protection
exclude = [
    "__pycache__",
    "*.pyc",
    "*.spec",
    "test_*.py",
    "*_test.py",
]

# License configuration
[license]
# License file output path
output = dist/licenses/

# Default license type: trial / subscription / perpetual
type = trial

# Trial period in days (0 = no trial)
trial_days = 30

# Features enabled per license tier
[tier.basic]
features = ["read", "write", "mock_mode"]

[tier.pro]
features = ["read", "write", "ai_chat", "ai_generate", "export"]

[tier.enterprise]
features = ["all"]

# Build hooks for CI/CD integration
[build]
pre_build = "echo 'Starting PyArmor protection...'"
post_build = "echo 'PyArmor protection complete.'"
on_error = "echo 'PyArmor build failed!' && exit 1"
