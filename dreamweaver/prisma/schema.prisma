// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// 用户与认证相关表
// ============================================

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  nickname          String?   @db.VarChar(100)
  avatarUrl         String?   @map("avatar_url") @db.VarChar(500)
  subscriptionTier  SubscriptionTier @default(free) @map("subscription_tier")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  preferences       UserPreferences?
  subscription      Subscription?
  projects          Project[]
  agentSessions     AgentSession[]
  hooks             HookConfig[]
  companionSprite   CompanionSprite?
  usageRecords      UsageRecord[]
  payments          Payment[]
  permissionAudits  PermissionAuditLog[]

  @@map("users")
}

model UserPreferences {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  uiLanguage      String    @default("zh") @map("ui_language") @db.VarChar(10)
  writingLanguage String    @default("zh") @map("writing_language") @db.VarChar(10)
  timezone        String    @default("Asia/Shanghai") @db.VarChar(50)
  currency        String    @default("CNY") @db.VarChar(3)
  region          String    @default("ap") @db.VarChar(10)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Subscription {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String            @unique @map("user_id") @db.Uuid
  plan                  SubscriptionPlan  @default(free)
  status                SubscriptionStatus @default(trialing)
  stripeCustomerId      String?           @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId  String?           @map("stripe_subscription_id") @db.VarChar(255)
  currentPeriodStart    DateTime?         @map("current_period_start") @db.Timestamp(6)
  currentPeriodEnd      DateTime?         @map("current_period_end") @db.Timestamp(6)
  cancelAtPeriodEnd     Boolean           @default(false) @map("cancel_at_period_end")
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("subscriptions")
}

// ============================================
// 项目与创作相关表
// ============================================

model Project {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  name              String          @db.VarChar(200)
  description       String?         @db.Text
  genre             String?         @db.VarChar(50)
  targetWordCount   Int?            @map("target_word_count")
  currentWordCount  Int             @default(0) @map("current_word_count")
  status            ProjectStatus   @default(draft)
  settings          Json?           @db.JsonB
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters      Chapter[]
  characters    Character[]
  worldSettings WorldSetting[]
  branches      Branch[]
  foreshadowing Foreshadowing[]
  agentSessions AgentSession[]
  hooks         HookConfig[]
  memoryEntries MemoryEntry[]
  promptCaches  PromptCacheEntry[]
  compactionRecords CompactionRecord[]
  permissionAudits  PermissionAuditLog[]

  @@map("projects")
}

model Chapter {
  id              String          @id @default(uuid()) @db.Uuid
  projectId       String          @map("project_id") @db.Uuid
  volumeNumber    Int             @map("volume_number")
  chapterNumber   Int             @map("chapter_number")
  title           String          @db.VarChar(200)
  content         String?         @db.Text
  wordCount       Int             @default(0) @map("word_count")
  status          ChapterStatus   @default(outline)
  branchId        String?         @map("branch_id") @db.Uuid
  parentVersion   String?         @map("parent_version") @db.Uuid
  metadata        Json?           @db.JsonB
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id])

  @@map("chapters")
}

model Character {
  id                String    @id @default(uuid()) @db.Uuid
  projectId         String    @map("project_id") @db.Uuid
  name              String    @db.VarChar(100)
  aliases           Json?     @db.JsonB
  roleType          RoleType  @map("role_type")
  profile           Json?     @db.JsonB
  relationships     Json?     @db.JsonB
  arc               Json?     @db.JsonB
  firstAppearance   String?   @map("first_appearance") @db.Uuid
  wordCount         Int       @default(0) @map("word_count")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("characters")
}

model WorldSetting {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  name            String    @db.VarChar(200)
  category        String    @db.VarChar(100)
  type            String    @db.VarChar(50)
  description     String?   @db.Text
  properties      Json?     @db.JsonB
  relations       Json?     @db.JsonB
  sourceChapters  Json?     @map("source_chapters") @db.JsonB
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("world_settings")
}

model Branch {
  id              String        @id @default(uuid()) @db.Uuid
  projectId       String        @map("project_id") @db.Uuid
  name            String        @db.VarChar(200)
  type            BranchType
  parentBranchId  String?       @map("parent_branch_id") @db.Uuid
  forkPoint       String?       @map("fork_point") @db.Uuid
  description     String?       @db.Text
  wordCount       Int           @default(0) @map("word_count")
  status          BranchStatus  @default(active)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@map("branches")
}

model Foreshadowing {
  id                    String              @id @default(uuid()) @db.Uuid
  projectId             String              @map("project_id") @db.Uuid
  content               String              @db.Text
  plantedChapterId      String?             @map("planted_chapter_id") @db.Uuid
  plantedText           String?             @map("planted_text") @db.Text
  expectedPayoffChapter Int?                @map("expected_payoff_chapter")
  actualPayoffChapterId String?             @map("actual_payoff_chapter_id") @db.Uuid
  status                ForeshadowingStatus @default(planted)
  priority              Priority            @default(medium)
  relatedCharacters     Json?               @map("related_characters") @db.JsonB
  notes                 String?             @db.Text
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("foreshadowing")
}

// ============================================
// AI 与 Harness 相关表
// ============================================

model AgentSession {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @map("project_id") @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  agentType         AgentType       @map("agent_type")
  parentAgentId     String?         @map("parent_agent_id") @db.Uuid
  mode              AgentMode
  status            AgentStatus     @default(active)
  task              String?         @db.Text
  turnCount         Int             @default(0) @map("turn_count")
  maxTurns          Int             @default(10) @map("max_turns")
  model             String?         @db.VarChar(50)
  contextSnapshot   Json?           @map("context_snapshot") @db.JsonB
  result            Json?           @db.JsonB
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamp(6)
  completedAt       DateTime?       @map("completed_at") @db.Timestamp(6)

  // Relations
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_sessions")
}

model HookConfig {
  id            String      @id @default(uuid()) @db.Uuid
  projectId     String?     @map("project_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  name          String      @db.VarChar(200)
  event         String      @db.VarChar(100)
  matchPattern  String?     @map("match_pattern") @db.VarChar(500)
  actionType    HookActionType @map("action_type")
  scriptType    ScriptType  @map("script_type")
  scriptPath    String?     @map("script_path") @db.VarChar(500)
  priority      Int         @default(0)
  enabled       Boolean     @default(true)
  config        Json?       @db.JsonB
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hooks_config")
}

model MemoryEntry {
  id                String          @id @default(uuid()) @db.Uuid
  projectId         String          @map("project_id") @db.Uuid
  sessionId         String?         @map("session_id") @db.Uuid
  type              String          @db.VarChar(50)
  content           String          @db.Text
  summary           String?         @db.Text
  sourceChapterId   String?         @map("source_chapter_id") @db.Uuid
  sourceText        String?         @map("source_text") @db.Text
  entities          Json?           @db.JsonB
  importance        Importance      @default(medium)
  compressionLevel  Int             @default(0) @map("compression_level")
  accessCount       Int             @default(0) @map("access_count")
  lastAccessed      DateTime?       @map("last_accessed") @db.Timestamp(6)
  expiresAt         DateTime?       @map("expires_at") @db.Timestamp(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("memory_entries")
}

model CompanionSprite {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @unique @map("user_id") @db.Uuid
  species             String      @db.VarChar(50)
  rarity              String      @db.VarChar(50)
  name                String?     @db.VarChar(100)
  level               Int         @default(1)
  experience          Int         @default(0)
  attributes          Json?       @db.JsonB
  evolution           String?     @db.VarChar(50)
  totalCompanionHours Decimal     @default(0) @map("total_companion_hours") @db.Decimal(10, 2)
  seed                BigInt?
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companion_sprites")
}

// ============================================
// Harness 专用表
// ============================================

model PromptCacheEntry {
  id            String          @id @default(uuid()) @db.Uuid
  projectId     String          @map("project_id") @db.Uuid
  cacheScope    CacheScope      @map("cache_scope")
  blockType     BlockType       @map("block_type")
  contentHash   String          @map("content_hash") @db.VarChar(64)
  tokenCount    Int             @map("token_count")
  hitCount      Int             @default(0) @map("hit_count")
  lastHitAt     DateTime?       @map("last_hit_at") @db.Timestamp(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("prompt_cache_entries")
}

model CompactionRecord {
  id                  String            @id @default(uuid()) @db.Uuid
  sessionId           String?           @map("session_id") @db.Uuid
  projectId           String            @map("project_id") @db.Uuid
  compactionLevel     CompactionLevel   @map("compaction_level")
  tokensBefore        Int               @map("tokens_before")
  tokensAfter         Int               @map("tokens_after")
  summaryContent      String?           @map("summary_content") @db.Text
  firstArchivedMsgId  String?           @map("first_archived_msg_id") @db.Uuid
  lastArchivedMsgId   String?           @map("last_archived_msg_id") @db.Uuid
  isReversible        Boolean           @default(true) @map("is_reversible")
  consecutiveFailures Int               @default(0) @map("consecutive_failures")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("compaction_records")
}

model PermissionAuditLog {
  id                String            @id @default(uuid()) @db.Uuid
  projectId         String?           @map("project_id") @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  sessionId         String?           @map("session_id") @db.Uuid
  operationType     String            @map("operation_type") @db.VarChar(100)
  classifierStage   ClassifierStage   @map("classifier_stage")
  decision          PermissionDecision
  reason            String?           @db.Text
  racerId           String?           @map("racer_id") @db.VarChar(50)
  processingTimeMs  Int               @map("processing_time_ms")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("permission_audit_log")
}

model FeatureGate {
  id                  String      @id @default(uuid()) @db.Uuid
  featureName         String      @unique @map("feature_name") @db.VarChar(100)
  gateLevel           GateLevel   @map("gate_level")
  enabled             Boolean     @default(false)
  rolloutPercentage   Int         @default(0) @map("rollout_percentage")
  config              Json?       @db.JsonB
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("feature_gates")
}

// ============================================
// 支付与用量相关表
// ============================================

model UsageRecord {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  periodStart   DateTime  @map("period_start") @db.Timestamp(6)
  periodEnd     DateTime  @map("period_end") @db.Timestamp(6)
  wordsUsed     Int       @default(0) @map("words_used")
  wordsLimit    Int       @default(0) @map("words_limit")
  aiTokensUsed  BigInt    @default(0) @map("ai_tokens_used")
  planId        String?   @map("plan_id") @db.VarChar(50)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_records")
}

model Payment {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String        @map("user_id") @db.Uuid
  subscriptionId          String?       @map("subscription_id") @db.Uuid
  stripePaymentIntentId   String?       @map("stripe_payment_intent_id") @db.VarChar(255)
  amount                  Decimal       @db.Decimal(10, 2)
  currency                String        @db.VarChar(3)
  status                  PaymentStatus @default(pending)
  refundedAt              DateTime?     @map("refunded_at") @db.Timestamp(6)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamp(6)

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@map("payments")
}

// ============================================
// Enums
// ============================================

enum SubscriptionTier {
  free
  pro
  enterprise
}

enum SubscriptionPlan {
  free
  pro
  studio
  team
}

enum SubscriptionStatus {
  active
  past_due
  canceled
  trialing
}

enum ProjectStatus {
  draft
  writing
  completed
  published
}

enum ChapterStatus {
  outline
  draft
  revised
  final
}

enum RoleType {
  protagonist
  antagonist
  supporting
  minor
}

enum BranchType {
  main
  exploration
  perspective
  timeline
  style
}

enum BranchStatus {
  active
  merged
  archived
}

enum ForeshadowingStatus {
  planted
  developing
  payoff
  verified
  forgotten
}

enum Priority {
  high
  medium
  low
}

enum AgentType {
  main
  coordinator
  sub
}

enum AgentMode {
  interactive
  proactive
  coordinator
}

enum AgentStatus {
  active
  paused
  completed
  failed
}

enum HookActionType {
  allow
  deny
  modify
  inform
}

enum ScriptType {
  builtin
  custom
  plugin
}

enum Importance {
  critical
  high
  medium
  low
}

enum CacheScope {
  global
  org
  session
}

enum BlockType {
  static
  dynamic
  attribution
}

enum CompactionLevel {
  L1
  L2
  L3
  L4
}

enum ClassifierStage {
  stage1
  stage2
  hook
  user
}

enum PermissionDecision {
  allow
  deny
  modify
}

enum GateLevel {
  compile
  runtime
  env
  api
}

enum PaymentStatus {
  succeeded
  pending
  failed
  refunded
}
